# Postgres (Neon on Vercel). Locally: `npx vercel env pull .env.local` or any Postgres URL.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
# generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
AUTH_SECRET=""
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD=""
STORAGE_DIR="./storage"
# On Vercel, set to true and configure Blob (BLOB_READ_WRITE_TOKEN). Client uploads bypass the 4.5 MB body limit.
NEXT_PUBLIC_BLOB_UPLOAD="false"
# Tutorials are public by default. Set to false to hide videos unless signed in as admin.
PUBLIC_LIBRARY="true"
# Learner self sign-up is off. Leave false unless you intentionally re-enable it.
ALLOW_REGISTRATION="false"
MAX_VIDEO_MB="2048"
